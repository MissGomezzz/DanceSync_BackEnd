     name: Battle Service CI
@@ -149,8 +169,77 @@ jobs:
       - name: Typecheck
         run: pnpm typecheck
 
-      - name: Run tests
-        run: pnpm test
+      # Runs the unit tests and measures coverage with c8 (fails below 80 % of lines).
+      - name: Run tests with coverage
+        run: pnpm test:coverage
+
+      # The SonarCloud job (MAN-1) reads this report.
+      - name: Upload coverage report
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: battle-service-coverage
+          path: battle-service/coverage/lcov.info
+          retention-days: 7
 
       - name: Build
-        run: pnpm build
\ No newline at end of file
+        run: pnpm build
+
+
+  sonarcloud:
+    name: SonarCloud analysis
+    runs-on: ubuntu-latest
+    needs: [api-gateway, users-service, battle-service]
+    # Secrets are not available to pull requests from forks.
+    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          # SonarCloud needs the full history to attribute new code and blame.
+          fetch-depth: 0
+
+      - name: Setup Java
+        uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
+        with:
+          distribution: temurin
+          java-version: '17'
+          cache: maven
+
+      # The Java analyzer needs the compiled classes.
+      - name: Compile the Java services
+        run: |
+          chmod +x api-gateway/mvnw users-service/mvnw
+          (cd api-gateway && ./mvnw -B -DskipTests compile)
+          (cd users-service && ./mvnw -B -DskipTests compile)
+
+      - name: Download api-gateway coverage
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
+        with:
+          name: api-gateway-coverage
+          path: api-gateway/target/site/jacoco
+
+      - name: Download users-service coverage
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
+        with:
+          name: users-service-coverage
+          path: users-service/target/site/jacoco
+
+      - name: Download battle-service coverage
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
+        with:
+          name: battle-service-coverage
+          path: battle-service/coverage
+
+      # c8 writes paths relative to battle-service; Sonar needs them relative to the repository root.
+      - name: Make the lcov paths relative to the repository
+        run: sed -i 's#^SF:#SF:battle-service/#' battle-service/coverage/lcov.info
+
+      # Static analysis (MAN-1). Waits for the Quality Gate and fails the job if it is red.
+      - name: SonarCloud scan
+        uses: SonarSource/sonarqube-scan-action@4d1dc0c91ee400dcf8a6dddf2f705ac36542e304 # v8.4.0
+        env:
+          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
+        with:
+          args: >
+            -Dsonar.qualitygate.wait=true
