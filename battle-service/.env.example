# battle-service environment. Copy to .env for local overrides.
PORT=3000
CORS_ORIGIN=http://localhost:5173
USERS_SERVICE_URL=http://localhost:8081
# Milliseconds a disconnected player keeps their seat (refresh / network drop).
DISCONNECT_GRACE_MS=15000
# Milliseconds players have to type the song-selection phrase.
SONG_CHALLENGE_MS=15000
# Word race: rounds per battle (fewer when the song is too short).
WORD_RACE_ROUNDS=3
# Milliseconds dancers have to type each word-race word.
WORD_RACE_WINDOW_MS=10000
# Minimum milliseconds between two word-race round openings.
WORD_RACE_MIN_GAP_MS=12000
# Bonus points a dancer earns for each word round won (added to the battle score).
WORD_BONUS_POINTS=1
# Song length assumed for the word-race timeline when the battle has no song.
WORD_RACE_FALLBACK_DURATION_MS=90000

# --- Authentication (SEG-1) -------------------------------------------------
# Microsoft Entra ID application whose access tokens are accepted (registered
# users). Left empty, every registered-user token is refused.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Optional. Accepted "aud" values, comma separated; defaults to AZURE_CLIENT_ID.
AZURE_API_AUDIENCE=
# Secret that signs the guest tokens (HS256), at least 32 bytes; the same value
# as in the api-gateway. Generate one with: openssl rand -base64 48
# Left empty, guest tokens are neither issued nor accepted.
GUEST_TOKEN_SECRET=
# Lifetime of a guest token, in seconds.
GUEST_TOKEN_TTL_SECONDS=7200
