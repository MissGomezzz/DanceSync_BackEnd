    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU per replica and service",
      "description": "battle-service: rate(process_cpu_seconds_total) (cores). Java services: process_cpu_usage (share of the CPUs the JVM sees).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"battle-service\"}[$__rate_interval])",
          "legendFormat": "{{instance}} (cores)",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_cpu_usage{job=~\"api-gateway|users-service\"}",
          "legendFormat": "{{instance}} (share)",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
