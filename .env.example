# Copy to .env and adjust as needed. Never commit the real .env file.

# PostgreSQL (docker-compose.yml and users-service)
POSTGRES_DB=dancesync
POSTGRES_USER=dancesync
POSTGRES_PASSWORD=dancesync
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# "require" for Azure Database for PostgreSQL; "prefer" uses TLS only when offered.
POSTGRES_SSLMODE=prefer

# Service ports
GATEWAY_PORT=8080
USERS_SERVICE_PORT=8081
BATTLE_SERVICE_PORT=3000

# Service URLs consumed by the api-gateway
USERS_SERVICE_URL=http://localhost:8081
BATTLE_SERVICE_URL=http://localhost:3000
BATTLE_SERVICE_WS_URL=ws://localhost:3000

# Frontend origin allowed by CORS (gateway and battle-service)
FRONTEND_ORIGIN=http://localhost:5173

# --- Authentication (SEG-1) -------------------------------------------------
# Microsoft Entra ID: tenant and application (client) id of the DanceSync app
# registration. The api-gateway and battle-service validate every access token
# against them (signature, expiry, issuer, audience). Left empty, every
# registered-user token is refused.
# AZURE_TENANT_ID: "common" = any organization and personal Microsoft accounts
# (no invitations needed); "organizations" = any organization; a tenant id =
# only that tenant's users.
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=
# Optional. Accepted "aud" values, comma separated; defaults to AZURE_CLIENT_ID.
AZURE_API_AUDIENCE=
# Secret that signs the guest tokens (HS256), at least 32 bytes. It must be the
# same in the api-gateway and battle-service. Generate one with:
#   openssl rand -base64 48
# Left empty, guest tokens are neither issued nor accepted.
GUEST_TOKEN_SECRET=
# Lifetime of a guest token, in seconds.
GUEST_TOKEN_TTL_SECONDS=7200

# --- Abuse and denial-of-service protection at the api-gateway (SEG-3) -------
# Token bucket per client address and kind of request; an empty bucket is
# answered 429 with Retry-After. Runs before authentication.
RATE_LIMIT_ENABLED=true
# Proxies in front of the gateway whose X-Forwarded-For entry is trusted
# (0 = ignore the header, which a client can forge).
TRUSTED_PROXY_HOPS=0
# Shared buckets for several gateway instances; empty = this instance's memory.
REDIS_URL=
# Per policy: requests per second (may be fractional) and burst.
RATE_LIMIT_ROOM_CREATE_PER_SECOND=1
RATE_LIMIT_ROOM_CREATE_BURST=10
RATE_LIMIT_GUEST_TOKEN_PER_SECOND=5
RATE_LIMIT_GUEST_TOKEN_BURST=20
RATE_LIMIT_SOCKET_HANDSHAKE_PER_SECOND=5
RATE_LIMIT_SOCKET_HANDSHAKE_BURST=30
RATE_LIMIT_SOCKET_POLLING_PER_SECOND=20
RATE_LIMIT_SOCKET_POLLING_BURST=40
RATE_LIMIT_OTHER_PER_SECOND=20
RATE_LIMIT_OTHER_BURST=40

# --- Non-repudiation and admin console (SEG-2) --------------------------------
# Shared secret of the internal calls: the audit batches sent by the api-gateway
# and battle-service to users-service, and the admin requests the gateway
# forwards. At least 32 bytes, the same in the three services:
#   openssl rand -base64 48
# Left empty, audit records wait in memory and the admin API answers 503.
AUDIT_INTERNAL_TOKEN=
# Microsoft Entra ID object id (oid) of the single admin account: the only user
# who can open the admin console (audit log, alerts). Empty = nobody.
ADMIN_USER_OID=
# HMAC key of the audit hash chain (users-service), at least 32 bytes. Without
# it the chain is plain SHA-256: tampering is detected, but someone with write
# access to the database could rebuild the chain.
AUDIT_CHAIN_KEY=
# Local GeoIP database (MaxMind format) for the region of each address. The
# users-service Docker image already has one (/app/geoip/dbip-lite.mmdb); when
# running it outside Docker:  sh scripts/download-geoip.sh  ->  geoip/dbip-lite.mmdb
GEOIP_DB_PATH=
# Prometheus (OBS-1), for the operational alerts of the admin console.
PROMETHEUS_URL=
