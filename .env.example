# Copy to .env and adjust as needed. Never commit the real .env file.

# PostgreSQL (docker-compose.yml and users-service)
POSTGRES_DB=dancesync
POSTGRES_USER=dancesync
POSTGRES_PASSWORD=dancesync
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Service ports
GATEWAY_PORT=8080
USERS_SERVICE_PORT=8081
BATTLE_SERVICE_PORT=3000

# Service URLs consumed by the api-gateway
USERS_SERVICE_URL=http://localhost:8081
BATTLE_SERVICE_URL=http://localhost:3000
BATTLE_SERVICE_WS_URL=ws://localhost:3000

# Frontend origin allowed by CORS (gateway and battle-service)
FRONTEND_ORIGIN=http://localhost:5173

# --- Authentication (SEG-1) -------------------------------------------------
# Microsoft Entra ID: tenant and application (client) id of the DanceSync app
# registration. The api-gateway and battle-service validate every access token
# against them (signature, expiry, issuer, audience). Left empty, every
# registered-user token is refused.
# AZURE_TENANT_ID: "common" = any organization and personal Microsoft accounts
# (no invitations needed); "organizations" = any organization; a tenant id =
# only that tenant's users.
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=
# Optional. Accepted "aud" values, comma separated; defaults to AZURE_CLIENT_ID.
AZURE_API_AUDIENCE=
# Secret that signs the guest tokens (HS256), at least 32 bytes. It must be the
# same in the api-gateway and battle-service. Generate one with:
#   openssl rand -base64 48
# Left empty, guest tokens are neither issued nor accepted.
GUEST_TOKEN_SECRET=
# Lifetime of a guest token, in seconds.
GUEST_TOKEN_TTL_SECONDS=7200
